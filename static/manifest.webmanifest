{
	"name": "Elbi GradeSim",
	"short_name": "GradeSim",
	"description": "UPLB GWA calculator, Latin honors simulator and course planner. Your grades stay in your browser.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#f6f1f0",
	"theme_color": "#7b2a22",
	"icons": [
		{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{ "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "/plumbob.svg", "sizes": "any", "type": "image/svg+xml" }
	]
}
